---
// Decorative contour lines behind the hero, generated at build time
// (deterministic: same lines on every build).
const W = 1600;
const H = 900;
const lineas: string[] = [];
for (let i = 0; i < 18; i++) {
	const base = 40 + i * 48;
	const amp = 38 + (i % 5) * 14;
	const fase = i * 0.55;
	const pts: [number, number][] = [];
	for (let x = -80; x <= W + 80; x += 80) {
		const y = base + amp * Math.sin(x / 260 + fase) + 22 * Math.sin(x / 97 + fase * 1.7);
		pts.push([x, y]);
	}
	// Catmull-Rom → cubic Bézier for smooth curves.
	let d = `M${pts[0][0]} ${pts[0][1].toFixed(1)}`;
	for (let k = 0; k < pts.length - 1; k++) {
		const p0 = pts[k - 1] ?? pts[k], p1 = pts[k], p2 = pts[k + 1], p3 = pts[k + 2] ?? p2;
		const c1 = [p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6];
		const c2 = [p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6];
		d += ` C${c1[0].toFixed(1)} ${c1[1].toFixed(1)} ${c2[0].toFixed(1)} ${c2[1].toFixed(1)} ${p2[0]} ${p2[1].toFixed(1)}`;
	}
	lineas.push(d);
}
---
<svg class="curvas" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice" aria-hidden="true">
	{lineas.map((d) => <path d={d} />)}
</svg>

<style>
	.curvas { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
	path { fill: none; stroke: #a8bd92; stroke-width: 1; opacity: 0.28; vector-effect: non-scaling-stroke; }
</style>
