---
// Full map page, shared by /mapa/, /pt/mapa/ and /en/map/.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Mapa, { type Pin } from '../components/Mapa.astro';
import { PROVINCIAS, urlDestino } from '../lib/rutas';
import { alternasMapa, proximosVisibles } from '../lib/traducciones';
import { traductor, type Idioma } from '../i18n/ui';

interface Props { idioma: Idioma }
const { idioma } = Astro.props;
const t = traductor(idioma);
const todos = await getCollection('destinos');
const claves = [...new Set(todos.map((d) => d.data.clave))];
const destinos = claves.map((c) => todos.find((d) => d.data.clave === c && d.data.idioma === idioma) ?? todos.find((d) => d.data.clave === c && d.data.idioma === 'es')!);
const proximos = await proximosVisibles(idioma);
const pins: Pin[] = [
	...destinos.map((d) => ({ nombre: d.data.nombre, coordenadas: d.data.coordenadas, url: urlDestino(d.data), detalle: PROVINCIAS[d.data.provincia], tipo: 'destino' as const })),
	...proximos.map((p) => ({ nombre: p.nombre, coordenadas: p.coordenadas, detalle: p.provincia, tipo: 'proximo' as const })),
];
const textos = { guia: t('mapa.popup.guia'), pronto: t('mapa.popup.pronto'), sinjs: t('mapa.sinjs') };
---
<Base idioma={idioma} title={t('mapa.title')} description={t('mapa.description')} alternas={alternasMapa()}>
	<div class="shell wrap">
		<h1>{t('mapa.h1')}</h1>
		<p class="note">{t('mapa.leyenda')}</p>
		<Mapa pins={pins} alto="min(75vh, 720px)" etiqueta={t('mapa.etiqueta')} textos={textos} />
		<h2>{t('mapa.destinos')}</h2>
		<ul class="lista">
			{destinos.map((d) => <li><a href={urlDestino(d.data)}>{d.data.nombre}</a>, {PROVINCIAS[d.data.provincia]}</li>)}
			{proximos.map((p) => <li>{p.nombre}, {p.provincia} <span class="note">{t('mapa.proximamente')}</span></li>)}
		</ul>
	</div>
</Base>

<style>
	.wrap { padding-block: 32px 72px; }
	h1 { font-size: clamp(30px, 4vw, 44px); }
	.lista { columns: 2 260px; padding-left: 18px; }
</style>
