---
// One <head> for every page: title, description, canonical, social preview,
// hreflang and JSON-LD. Drafts get noindex and a visible banner.
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
	description: string;
	borrador?: boolean;
	jsonld?: object[];
	headerOscuro?: boolean;
}
const { title, description, borrador = false, jsonld = [], headerOscuro = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="es-AR">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="alternate" hreflang="es" href={canonical} />
		<link rel="alternate" hreflang="x-default" href={canonical} />
		{borrador && <meta name="robots" content="noindex" />}
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Pescamapa" />
		<meta property="og:locale" content="es_AR" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="theme-color" content="#11251f" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		{jsonld.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
	</head>
	<body>
		{borrador && (
			<div class="borrador" role="note">
				<div class="shell">
					<strong>Ficha en construcción.</strong> Hay datos pendientes de verificación; no la uses todavía para planificar un viaje.
				</div>
			</div>
		)}
		<Header oscuro={headerOscuro} />
		<main id="contenido">
			<slot />
		</main>
		<Footer />
	</body>
</html>

<style>
	.borrador {
		background: var(--warn-bg);
		border-bottom: 1px solid var(--warn-line);
		font-size: 14px;
		padding: 10px 0;
		position: relative;
		z-index: 10;
	}
</style>
