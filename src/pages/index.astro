---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Mapa, { type Pin } from '../components/Mapa.astro';
import proximos from '../data/proximos.json';
import { REGIONES, PROVINCIAS, urlDestino } from '../lib/rutas';

const destinos = await getCollection('destinos');
const especies = new Map((await getCollection('especies')).map((e) => [e.id, e.data.nombre]));

const pins: Pin[] = [
	...destinos.map((d) => ({ nombre: d.data.nombre, coordenadas: d.data.coordenadas, url: urlDestino(d.data), detalle: PROVINCIAS[d.data.provincia], tipo: 'destino' as const })),
	...proximos.map((p) => ({ nombre: p.nombre, coordenadas: p.coordenadas as [number, number], detalle: p.provincia, tipo: 'proximo' as const })),
];

const jsonld = [
	{
		'@context': 'https://schema.org',
		'@type': 'WebSite',
		name: 'Pescamapa',
		url: Astro.site!.href,
		inLanguage: 'es-AR',
		description: 'Destinos, especies y guías para pescar en Argentina.',
		creator: { '@type': 'Person', name: 'Cheyenne Justiniano' },
	},
];
---
<Base
	title="Pescamapa: destinos, especies y guías para pescar en Argentina"
	description="Encontrá dónde pescar en Argentina: destinos por región y especie, temporadas, reglamentos con fecha de revisión y guías locales. Del surubí del Paraná a la trucha."
	jsonld={jsonld}
	headerOscuro
>
	<section class="hero on-dark">
		<div class="shell">
			<div class="eyebrow">El mapa para salir a pescar</div>
			<h1>Argentina<br />se pesca<br /><em>de mil formas.</em></h1>
			<p class="copy">Del surubí en las islas del Paraná a la trucha en los Andes. Encontrá el destino que encaja con tu próxima salida.</p>
			<div class="actions">
				<a class="button primary" href="#destinos">Explorar destinos ↓</a>
				<a class="button secondary" href="/mapa/">Ver el mapa ↗</a>
			</div>
			<ul class="stats">
				<li><strong>Ríos y humedales</strong>El pulso del Litoral</li>
				<li><strong>Lagos y cordillera</strong>La Patagonia pescadora</li>
				<li><strong>Lagunas y mar</strong>Escapadas cerca de casa</li>
			</ul>
		</div>
	</section>

	<div class="strip">
		<div class="shell strip-inner">
			<span>✳ Agua, especie y modalidad</span>
			<span>✳ Reglamentos con fecha de revisión</span>
			<span>✳ Prestadores de la zona</span>
		</div>
	</div>

	<section id="destinos" class="section">
		<div class="shell">
			<div class="head">
				<div>
					<div class="eyebrow">Por dónde empezar</div>
					<h2>Destinos que dejan huella.</h2>
				</div>
				<p>Arrancamos por el Paraná correntino. Cada guía se publica cuando sus datos están verificados con fuentes oficiales.</p>
			</div>
			<div class="grid">
				{destinos.map((d) => (
					<a class="card live" href={urlDestino(d.data)}>
						<div class="img river"><span class="pill">{REGIONES[d.data.region].toUpperCase()} · {PROVINCIAS[d.data.provincia].toUpperCase()}</span></div>
						<div class="body">
							<h3>{d.data.nombre}</h3>
							<p>{d.data.bajada}</p>
							<ul class="chips">{d.data.especies.map((e) => <li>{especies.get(e.id)}</li>)}</ul>
						</div>
						<div class="foot"><span>{d.data.estado === 'borrador' ? 'Guía en construcción' : 'Ver la guía'}</span><span class="arrow" aria-hidden="true">↗</span></div>
					</a>
				))}
				{proximos.map((p) => (
					<article class="card soon">
						<div class={`img ${p.region}`}><span class="pill">{REGIONES[p.region].toUpperCase()} · {p.provincia.toUpperCase()}</span></div>
						<div class="body">
							<div class="loc">{p.agua}</div>
							<h3>{p.nombre}</h3>
							<ul class="chips">{p.especies.map((e) => <li>{e}</li>)}</ul>
						</div>
						<div class="foot"><span>Próximamente</span></div>
					</article>
				))}
			</div>
			<p class="note">Las temporadas, especies habilitadas, tallas, cupos y modalidades dependen del ambiente y del reglamento vigente. Confirmá siempre con la autoridad local antes de salir.</p>
		</div>
	</section>

	<section class="section map-section">
		<div class="shell map-grid">
			<div>
				<div class="eyebrow">Argentina, agua por agua</div>
				<h2>Un mapa para encontrar tu río.</h2>
				<p>Empezá por una región y afiná por especie, modalidad y el tipo de viaje que querés hacer.</p>
				<a class="button dark" href="/mapa/">Abrir el mapa completo ↗</a>
			</div>
			<Mapa pins={pins} alto="460px" etiqueta="Mapa de destinos de pesca en Argentina" />
		</div>
	</section>

	<section class="section">
		<div class="shell">
			<div class="head">
				<div>
					<div class="eyebrow">Más que una lista de lugares</div>
					<h2>Que planificar la salida sea parte del viaje.</h2>
				</div>
			</div>
			<div class="purpose">
				<article><div class="num">01 / DESCUBRIR</div><h3>El destino adecuado</h3><p>Compará regiones, especies y modalidades para elegir una salida que encaje con tu experiencia y tus fechas.</p></article>
				<article><div class="num">02 / PLANIFICAR</div><h3>Datos útiles y actuales</h3><p>Temporadas, permisos y accesos explicados con fecha de revisión y enlace a la fuente oficial.</p></article>
				<article><div class="num">03 / CONECTAR</div><h3>Gente que conoce el agua</h3><p>Guías y alojamientos con información clara, publicados con su consentimiento y precios con fecha.</p></article>
			</div>
		</div>
	</section>

	<section id="prestadores" class="section join">
		<div class="shell join-inner">
			<div>
				<div class="eyebrow">Para guías y alojamientos</div>
				<h2>El buen trabajo local merece encontrarse.</h2>
				<p>Estamos armando la red de prestadores destino por destino. Esta primera versión no toma reservas ni publica servicios comerciales.</p>
			</div>
		</div>
	</section>
</Base>

<style>
	.hero { background: var(--forest); color: var(--white); padding: 150px 0 72px; position: relative; overflow: hidden; }
	.hero::before {
		content: ''; position: absolute; width: 780px; height: 780px; right: -200px; top: 15px; border-radius: 50%;
		background: radial-gradient(circle at 50% 45%, rgb(123 153 118 / 0.38), rgb(34 65 53 / 0.16) 46%, transparent 68%);
	}
	.hero .shell { position: relative; }
	.hero h1 { font-size: clamp(48px, 6.7vw, 84px); line-height: 0.98; margin: 22px 0; }
	.hero h1 em { font-style: normal; color: var(--lime); }
	.copy { color: var(--on-dark); font-size: 18px; max-width: 520px; }
	.actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 30px; }
	.stats { display: flex; flex-wrap: wrap; gap: 28px; list-style: none; padding: 0; margin: 56px 0 0; color: var(--on-dark); font-size: 13px; }
	.stats li { border-left: 1px solid rgb(255 255 255 / 0.2); padding-left: 13px; }
	.stats strong { display: block; color: var(--white); font: 700 15px var(--font-head); }

	.strip { background: var(--lime); color: var(--forest); padding: 15px 0; font-size: 13px; font-weight: 700; }
	.strip-inner { display: flex; justify-content: space-between; gap: 12px 24px; flex-wrap: wrap; }

	.section { padding: clamp(56px, 9vw, 94px) 0; }
	.head { display: flex; justify-content: space-between; align-items: end; gap: 30px; flex-wrap: wrap; margin-bottom: 34px; }
	.head h2 { font-size: clamp(32px, 4vw, 48px); margin: 12px 0 0; }
	.head p { max-width: 400px; color: var(--muted); margin: 0; }

	.grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: 17px; margin-bottom: 20px; }
	.card { background: var(--white); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; display: flex; flex-direction: column; text-decoration: none; }
	.card.live { transition: transform 0.22s, box-shadow 0.22s; border-color: var(--forest); }
	.card.live:hover { transform: translateY(-4px); box-shadow: 0 18px 38px rgb(23 37 28 / 0.08); }
	.card.soon { opacity: 0.8; }
	.img { height: 170px; position: relative; background: var(--moss); }
	.img.river, .img.litoral { background: linear-gradient(170deg, transparent 48%, #8aa49a 49%, #2d5146 100%), linear-gradient(130deg, #6e7d5e 0 34%, #283d31 35% 54%, #a9a783 55% 66%, #314538 67%); }
	.img.patagonia { background: linear-gradient(180deg, #aabbb1 0 37%, #658277 38% 50%, #56716c 51% 64%, #263d34 65%); }
	.img.pampa { background: linear-gradient(180deg, #abb9ad 0 45%, #607d6d 46% 58%, #8b9d82 59% 64%, #c2b68a 65%); }
	.img.costa { background: linear-gradient(178deg, #a7b9b4 0 42%, #718e8c 43% 62%, #d5c9a9 63% 69%, #405649 70%); }
	.pill { position: absolute; left: 14px; top: 14px; background: var(--paper); padding: 6px 10px; border-radius: 99px; font-size: 10px; font-weight: 700; letter-spacing: 0.04em; }
	.body { padding: 18px 19px; flex: 1; display: flex; flex-direction: column; gap: 4px; }
	.body h3 { font-size: 22px; margin: 4px 0 6px; }
	.body p { font-size: 14px; color: var(--muted); }
	.body .chips { margin-top: auto; }
	.loc { font-size: 11px; letter-spacing: 0.11em; text-transform: uppercase; color: var(--muted); font-weight: 700; }
	.foot { border-top: 1px solid var(--line); padding: 12px 19px; display: flex; justify-content: space-between; font-size: 13px; color: var(--muted); }
	.arrow { color: var(--forest); font-weight: 700; }

	.map-section { background: var(--cream); }
	.map-grid { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: clamp(28px, 5vw, 54px); align-items: center; }
	.map-grid h2 { font-size: clamp(34px, 4vw, 52px); margin: 14px 0 18px; }
	.map-grid p { color: var(--muted); max-width: 440px; }
	@media (max-width: 860px) { .map-grid { grid-template-columns: 1fr; } }

	.purpose { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: 17px; }
	.purpose article { border-top: 2px solid var(--forest); padding-top: 18px; }
	.num { font: 700 12px var(--font-head); color: var(--olive); letter-spacing: 0.08em; margin-bottom: 10px; }
	.purpose p { color: var(--muted); }

	.join { background: var(--lime); }
	.join h2 { font-size: clamp(30px, 4vw, 46px); margin-top: 12px; }
	.join-inner { max-width: 760px; }
</style>
