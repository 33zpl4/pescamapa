---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { PROVINCIAS, urlDestino } from '../../lib/rutas';
import { sinPendientes } from '../../lib/pendientes';

export async function getStaticPaths() {
	const especies = await getCollection('especies');
	return especies.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const e = entry.data;
sinPendientes(entry.id, e.estado, entry.body);
const { Content } = await render(entry);
// Species → destinations: the internal link the strategy asks for, computed.
const destinos = (await getCollection('destinos')).filter((d) => d.data.especies.some((r) => r.id === entry.id));
---
<Base title={e.title} description={e.description} borrador={e.estado !== 'publicado'}>
	<header class="top">
		<div class="shell">
			<div class="eyebrow">Especie</div>
			<h1>{e.nombre} <small><i>{e.cientifico}</i></small></h1>
			<p>{e.resumen}</p>
		</div>
	</header>
	<div class="shell body">
		<div class="prose"><Content /></div>
		{destinos.length > 0 && (
			<>
				<h2>Dónde pescar {e.nombre.toLowerCase()}</h2>
				<ul class="chips">{destinos.map((d) => <li><a href={urlDestino(d.data)}>{d.data.nombre}, {PROVINCIAS[d.data.provincia]}</a></li>)}</ul>
			</>
		)}
	</div>
</Base>

<style>
	.top { background: var(--forest); color: var(--white); padding: 48px 0; }
	.top .eyebrow { color: var(--lime); }
	h1 { font-size: clamp(34px, 5vw, 56px); margin-top: 14px; }
	h1 small { font-size: 0.4em; font-weight: 500; color: var(--on-dark); letter-spacing: 0; }
	.top p { color: var(--on-dark); max-width: 640px; font-size: 18px; }
	.body { padding-block: 40px 80px; max-width: 820px; }
	.prose :global(blockquote) { margin: 1em 0; padding: 12px 16px; background: var(--warn-bg); border-left: 3px solid var(--warn-line); border-radius: 6px; font-size: 14px; }
	.prose :global(blockquote p) { margin: 0; }
	h2 { margin-top: 1.4em; }
</style>
