---
import { getDestinos } from '../../../../lib/destinos';
import Destino from '../../../../vistas/Destino.astro';

export async function getStaticPaths() {
	const destinos = (await getDestinos()).filter((e) => e.data.idioma === 'pt');
	return destinos.map((entry) => ({
		params: { region: entry.data.region, provincia: entry.data.provincia, slug: entry.data.slug },
		props: { entry },
	}));
}
const { entry } = Astro.props;
---
<Destino entry={entry} />
