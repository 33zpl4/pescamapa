---
// One 404 for every language: short and trilingual.
import Base from '../layouts/Base.astro';
---
<Base idioma="es" title="Página no encontrada | Pescamapa" description="La página que buscás no existe o cambió de dirección. Volvé al inicio o abrí el mapa para encontrar tu próximo destino de pesca en Argentina." borrador>
	<div class="shell" style="padding-block: 80px">
		<h1>Acá no pica nada.</h1>
		<p>La página que buscás no existe o cambió de dirección.</p>
		<p lang="pt-BR">Aqui não tem peixe: esta página não existe. <a href="/pt/">Ir para o início</a></p>
		<p lang="en">Nothing biting here: this page doesn’t exist. <a href="/en/">Go to the home page</a></p>
		<p><a class="button dark" href="/">Volver al inicio</a> <a class="button dark" href="/mapa/">Abrir el mapa</a></p>
	</div>
</Base>
